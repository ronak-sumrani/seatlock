# Local development credentials. Copy to .env (gitignored) and change if you like:
#   cp .env.example .env
# Read by deploy/docker-compose.yml (env_file) and by each service (spring.config.import).

# Superuser, used only by the Postgres image and the init script.
POSTGRES_DB=seatlock
POSTGRES_USER=seatlock_admin
POSTGRES_PASSWORD=admin_dev_pw

# One login role per service (spec §3). Role names are fixed in the init script.
USER_CATALOG_DB_PASSWORD=user_catalog_dev_pw
INVENTORY_DB_PASSWORD=inventory_dev_pw
BOOKING_DB_PASSWORD=booking_dev_pw
PAYMENT_DB_PASSWORD=payment_dev_pw

# Read-only role for the invariant checker (SELECT on every schema).
CHECKER_RO_DB_PASSWORD=checker_ro_dev_pw
