*.sh          text eol=lf
*.lua         text eol=lf
*.sql         text eol=lf
mvnw          text eol=lf
Dockerfile    text eol=lf
Dockerfile.*  text eol=lf
*.Dockerfile  text eol=lf
# Spotless enforces LF; keep git from converting these to CRLF on Windows checkout.
*.java        text eol=lf
*.xml         text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.properties  text eol=lf
*.md          text eol=lf
# Read by Docker env_file and Spring; a CRLF checkout would leave '\r' at the end of every value.
.env.example  text eol=lf
mvnw.cmd      text eol=crlf
